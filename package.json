{
  "name": "open-dot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": { "open-dot": "dist/cli.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node dist/server.test.js",
    "login": "npm run build && node dist/cli.js login",
    "doctor": "npm run build && node dist/cli.js doctor",
    "ask": "npm run build && node dist/cli.js ask",
    "start": "node dist/cli.js serve"
  },
  "dependencies": { "playwright": "^1.55.0" },
  "devDependencies": { "@types/node": "^20.19.0", "typescript": "^5.9.0" }
}
